{
  "contract_version": "fabric.adapter/v1alpha2",
  "adapter_id": "nvidia.fabric.openclaw",
  "adapter_kind": "python",
  "runner": {
    "module": "nemo_fabric_adapters.openclaw.adapter"
  },
  "settings_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "openclaw_command": {
        "type": "string",
        "minLength": 1,
        "description": "OpenClaw executable name or path. Relative paths containing a directory are resolved from the NeMo Fabric base directory."
      },
      "agent_id": {
        "type": "string",
        "minLength": 1,
        "default": "default",
        "description": "OpenClaw agent selected for Fabric-originated invocations."
      },
      "agent_runtime": {
        "type": "string",
        "enum": ["openclaw", "codex"],
        "default": "openclaw",
        "description": "OpenClaw agent harness runtime. The codex value requires the official @openclaw/codex plugin."
      },
      "telegram": {
        "type": "object",
        "properties": {
          "bot_token_env": {"type": "string", "minLength": 1},
          "api_root": {"type": "string", "minLength": 1},
          "dm_policy": {
            "type": "string",
            "enum": ["pairing", "allowlist", "open", "disabled"]
          },
          "allow_from": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "required": ["bot_token_env"],
        "additionalProperties": false,
        "description": "Telegram channel configuration for Fabric-owned services. Managed runtimes reject channel configuration."
      },
      "port_range": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65425
          },
          "end": {
            "type": "integer",
            "minimum": 111,
            "maximum": 65535
          }
        },
        "required": ["start", "end"],
        "additionalProperties": false,
        "description": "Inclusive consumer-allocated port range. The adapter selects a Gateway base port whose complete derived footprint through base + 110 fits within the range. When omitted, the adapter selects an available local range."
      },
      "startup_timeout_seconds": {
        "type": "number",
        "exclusiveMinimum": 0,
        "default": 30,
        "description": "Maximum time to wait for the OpenClaw Gateway to become ready."
      },
      "shutdown_timeout_seconds": {
        "type": "number",
        "exclusiveMinimum": 0,
        "default": 10,
        "description": "Maximum graceful Gateway shutdown time before forced termination."
      },
      "connect_timeout_seconds": {
        "type": "number",
        "exclusiveMinimum": 0,
        "default": 10,
        "description": "Timeout for connecting to the local OpenClaw Gateway."
      },
      "read_timeout_seconds": {
        "type": "number",
        "exclusiveMinimum": 0,
        "default": 600,
        "description": "Timeout between response bytes from the local OpenClaw Gateway."
      }
    },
    "additionalProperties": false
  },
  "model_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "provider": {"type": "string", "minLength": 1},
      "model": {"type": "string", "minLength": 1},
      "api_key_env": {"type": "string", "minLength": 1},
      "base_url": {"type": "string", "minLength": 1},
      "temperature": {"type": "number"},
      "top_p": {"type": "number", "minimum": 0, "maximum": 1},
      "max_tokens": {"type": "integer", "minimum": 1},
      "settings": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    "required": ["provider", "model"],
    "additionalProperties": false
  },
  "requirements": {},
  "config": {
    "accepts": [
      "models",
      "models.base_url",
      "models.temperature",
      "models.top_p",
      "models.max_tokens",
      "instructions.system",
      "tools.enabled",
      "tools.blocked",
      "mcp",
      "skills"
    ],
    "system_instruction_modes": ["replace"]
  },
  "capabilities": {
    "service": true,
    "streaming": false,
    "updates": false,
    "cancellation": false
  }
}
