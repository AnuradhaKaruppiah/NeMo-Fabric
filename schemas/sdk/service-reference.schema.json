{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Caller-supplied reference to an already-running service.",
  "properties": {
    "connection": {
      "additionalProperties": true,
      "description": "Non-secret connection fields and credential references.",
      "type": "object"
    },
    "metadata": {
      "additionalProperties": true,
      "description": "Adapter-specific caller-owned service metadata.",
      "type": "object"
    },
    "provider": {
      "description": "Provider responsible for the service.",
      "type": "string"
    },
    "service_type": {
      "description": "Stable service type understood by the selected adapter.",
      "type": "string"
    }
  },
  "required": [
    "provider",
    "service_type"
  ],
  "title": "ServiceReference",
  "type": "object"
}